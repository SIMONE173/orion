{
  "name": "orion-desktop",
  "version": "1.1.0",
  "description": "ORION Desktop — il tuo assistente, con le mani sul computer",
  "main": "main.js",
  "author": "ORION",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:demo": "electron-builder --publish never -c.productName='ORION Demo' -c.appId=app.orion.demo -c.artifactName='ORION-Demo-${version}-${arch}.${ext}' -c.extraMetadata.productName='ORION Demo' -c.publish.url=https://orionvision.it/api/aggiorna/demo",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:demo:win": "electron-builder --win nsis --x64 --publish never -c.productName='ORION Demo' -c.appId=app.orion.demo -c.extraMetadata.productName='ORION Demo' -c.win.artifactName='ORION-Demo-${version}-win.${ext}' -c.nsis.shortcutName='ORION Demo' -c.publish.url=https://orionvision.it/api/aggiorna/demo"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.orion.desktop",
    "productName": "ORION",
    "files": [
      "main.js",
      "preload.js",
      "whisper.js",
      "gesti-ax.js"
    ],
    "asarUnpack": [
      "gesti-ax.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "ORION usa la fotocamera per digitalizzare i documenti e descrivere le foto.",
        "NSMicrophoneUsageDescription": "ORION usa il microfono per parlare con te.",
        "NSAppleEventsUsageDescription": "ORION usa gli eventi di sistema per aprire e chiudere le app che gli chiedi."
      }
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-win.${ext}"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORION",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "it_IT"
      ],
      "language": "1040"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://orionvision.it/api/aggiorna",
        "channel": "latest"
      }
    ]
  }
}
